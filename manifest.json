{
  "manifest_version": 2,
  "name": "OpenCount",
  "version": "1.0.0",
  "description": "Track visit counts and active time by domain.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "OpenCount",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opencount@nonary.software",
      "data_collection_permissions": {
        "required": ["none"],
        "collects_personal_data": false,
        "collects_browsing_activity": false,
        "collects_website_content": false,
        "collects_technical_and_interaction_data": false,
        "collects_location": false
      }
    }
  }
}
